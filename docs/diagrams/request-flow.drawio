        <mxCell id="title" value="&lt;b&gt;Flujo de una tool y barreras de seguridad&lt;/b&gt;&lt;br&gt;&lt;font color='#9fb0d0'&gt;De la llamada MCP a la respuesta tipada&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#f2f7ff;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="60" as="geometry"/></mxCell>
