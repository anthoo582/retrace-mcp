<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="retrace-mcp" modified="2026-01-01T00:00:00.000Z">
  <diagram id="port-pipeline" name="Pipeline N64 → PS2">
    <mxGraphModel dx="1440" dy="435" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="435" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Pipeline de portabilidad N64 → PS2&lt;/b&gt;&lt;br&gt;&lt;font color='#9fb0d0'&gt;Cinco fases, tres gates de evidencia, cero afirmaciones sin prueba&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#f2f7ff;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="24" width="1100" height="60" as="geometry"/></mxCell>
        <mxCell id="phase-1" value="&lt;b&gt;1 · Intake y validación&lt;/b&gt;&lt;br&gt;&lt;font color='#9fb0d0'&gt;requisitos y límites&lt;/font&gt;&lt;br&gt;• project_intake&lt;br&gt;• rom_validate&lt;br&gt;• toolchain_probe&lt;br&gt;• retrace_probe" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#12222e;strokeColor=#6ee7ff;strokeWidth=2;fontColor=#6ee7ff;fontSize=14;fontStyle=0;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="45" y="140" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="phase-2" value="&lt;b&gt;2 · Inspección binaria&lt;/b&gt;&lt;br&gt;&lt;font color='#9fb0d0'&gt;formato, secciones, símbolos&lt;/font&gt;&lt;br&gt;• rom_inspect&lt;br&gt;• rom_identify_format&lt;br&gt;• rom_find_code_regions&lt;br&gt;• elf_inspect&lt;br&gt;• elf_list_symbols" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#122c27;strokeColor=#59f2b0;strokeWidth=2;fontColor=#59f2b0;fontSize=14;fontStyle=0;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="317" y="140" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="phase-3" value="&lt;b&gt;3 · Análisis y evidencia&lt;/b&gt;&lt;br&gt;&lt;font color='#9fb0d0'&gt;solo confirmed con prueba&lt;/font&gt;&lt;br&gt;• mips_disassemble&lt;br&gt;• mips_analyze_function&lt;br&gt;• ghidra_import&lt;br&gt;• graph_ingest&lt;br&gt;• compare_functions&lt;br&gt;• equivalence_record" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2c2118;strokeColor=#ff9a3d;strokeWidth=2;fontColor=#ff9a3d;fontSize=14;fontStyle=0;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="589" y="140" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="phase-4" value="&lt;b&gt;4 · Traducción y proyecto&lt;/b&gt;&lt;br&gt;&lt;font color='#9fb0d0'&gt;escritura explícita&lt;/font&gt;&lt;br&gt;• port_project_plan&lt;br&gt;• binary_translate&lt;br&gt;• generate_ps2_project&lt;br&gt;• decomp_config_apply_changes&lt;br&gt;• split_rom" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#211a38;strokeColor=#b69cff;strokeWidth=2;fontColor=#b69cff;fontSize=14;fontStyle=0;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="861" y="140" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="phase-5" value="&lt;b&gt;5 · Build y validación&lt;/b&gt;&lt;br&gt;&lt;font color='#9fb0d0'&gt;evidencia reproducible&lt;/font&gt;&lt;br&gt;• build_ps2&lt;br&gt;• build_run&lt;br&gt;• port_validate_translation&lt;br&gt;• emulator-hardware-validation&lt;br&gt;• generate_forensic_report" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2b2717;strokeColor=#ffd166;strokeWidth=2;fontColor=#ffd166;fontSize=14;fontStyle=0;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1133" y="140" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="rule" value="&lt;b&gt;Regla de oro&lt;/b&gt;&lt;br&gt;&lt;font color='#9fb0d0'&gt;Ninguna tool declara equivalencia semántica: confirmed solo se escribe con equivalence_record y evidencia. Toda escritura exige RETRACE_ALLOW_WRITE=1 + confirmación explícita. La similitud estructural no reemplaza la validación en emulador o hardware autorizado.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2c171b;strokeColor=#ff6b6b;strokeWidth=2;fontColor=#ff6b6b;fontSize=14;fontStyle=0;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="45" y="325" width="1340" height="84" as="geometry"/></mxCell>
        <mxCell id="e-phase-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ff9a3d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#9fb0d0;fontSize=10;labelBackgroundColor=#0d1226;" edge="1" parent="1" source="phase-1" target="phase-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-phase-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ff9a3d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#9fb0d0;fontSize=10;labelBackgroundColor=#0d1226;" edge="1" parent="1" source="phase-2" target="phase-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-phase-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ff9a3d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#9fb0d0;fontSize=10;labelBackgroundColor=#0d1226;" edge="1" parent="1" source="phase-3" target="phase-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-phase-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ff9a3d;strokeWidth=2;endArrow=block;endFill=1;fontColor=#9fb0d0;fontSize=10;labelBackgroundColor=#0d1226;" edge="1" parent="1" source="phase-4" target="phase-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
