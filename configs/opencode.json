{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "retrace": {
      "type": "local",
      "command": ["python", "-m", "retrace_mcp", "--transport", "stdio"],
      "enabled": true,
      "environment": {
        "RETRACE_TARGET": ".",
        "RETRACE_LOG_LEVEL": "INFO"
      }
    }
  }
}
